{
    "metadata": {
        "standard": "NASA-STD-3001 Vol. 1 Rev. C (2023) y Vol. 2 Rev. E (2025)",
        "mission_profile": "Tránsito interplanetario a Marte (>30/60 días, microgravedad prolongada, entorno cerrado)",
        "sensors": [
            "Astroskin Bio-Monitor (arquitectura seleccionada por el equipo)",
            "Actiwatch Spectrum (arquitectura seleccionada por el equipo)",
            "Glucómetro externo / entrada manual multimodal"
        ],
        "communication_latency_min": 20,
        "communication_round_trip_min": 40,
        "wearable_disclaimer": "ASTROSKIN y ACTIWATCH no figuran homologados en NASA-STD-3001; el equipo los selecciona para satisfacer V1 3004.h, V1 6001 y V2 9023.",
        "clinical_threshold_disclaimer": "NASA-STD-3001 no fija umbrales numéricos individuales de reposo para presión arterial, frecuencia cardíaca, glucemia ni estado de ánimo; se emplean rangos clínicos operativos sobre línea base pre-misión (V1 3000, V1 4011, V1 4015-4017), junto con umbrales explícitos de norma (hipotermia central < 35 °C en Vol. 1 Apéndice C, sueño 8.5 h en V1 6001, P_I O2 y ppCO2 en V2 6003-6004).",
        "risk_classes": {
            "0": "Normal",
            "1": "Preventivo",
            "2": "Crítico"
        },
        "nasa_alert_hierarchy": {
            "Emergency": "Rojo parpadeante (Tabla 10.3-1 / F.5-1) - Acción inmediata ante amenaza vital",
            "Warning": "Rojo sólido (Tabla 10.3-1 / F.5-1) - Acción inmediata por riesgo de escalado crítico",
            "Caution": "Amarillo (Tabla 10.3-1 / F.5-1) - Atención requerida, sin acción inmediata",
            "Advisory": "Azul (Tabla 10.3-1 / F.5-1) - Aviso rutinario o desviación menor",
            "Nominal": "Verde indicador (Tabla 10.4-3) - Operación nominal",
            "Stale": "Cian (Tabla F.5-1 / V2 10020) - Datos faltantes u obsoletos"
        }
    },
    "biomarkers": {
        "presion_sistolica": {
            "unit": "mmHg",
            "sensor": "Astroskin (estimación) / manguito clínico",
            "indicador_consigna": "Presión arterial",
            "normal": [105.0, 125.0],
            "preventivo_bajo": [90.0, 104.9],
            "preventivo_alto": [125.1, 145.0],
            "critico_bajo": 90.0,
            "critico_alto": 145.0,
            "nasa_ref": "V1 3004.h, Tabla E.2-2, V2 7042 (umbral clínico de referencia; sin cifra fija en 3001)"
        },
        "temp_corporal": {
            "unit": "°C",
            "sensor": "Astroskin (temperatura cutánea)",
            "indicador_consigna": "Temperatura corporal (piel)",
            "normal": [35.6, 36.9],
            "preventivo_bajo": [34.8, 35.59],
            "preventivo_alto": [36.91, 37.6],
            "critico_bajo": 34.8,
            "critico_alto": 37.6,
            "note": "Astroskin mide temperatura de piel; la norma Vol. 1 Apéndice C fija hipotermia en < 35.0 °C central y V2 11011 distingue deterioro térmico cutáneo (> +1.4 °C) del central (> +0.6 °C).",
            "nasa_ref": "Vol. 1 Apéndice C (<35 °C central), V2 6014, V2 11011"
        },
        "nivel_actividad": {
            "unit": "g-index",
            "sensor": "Actiwatch / Astroskin",
            "indicador_consigna": "Contexto esfuerzo físico",
            "normal": [0.1, 1.8],
            "preventivo_alto": [1.81, 3.0],
            "critico_alto": 3.0,
            "note": "Valores > 3.0 en cabina o reposo sugieren temblor, convulsión o impacto; contextualiza esfuerzo físico (V2 10200).",
            "nasa_ref": "V2 10200, V1 3004.h"
        },
        "spo2": {
            "unit": "%",
            "sensor": "Astroskin (oximetría de pulso)",
            "indicador_consigna": "Contexto hipoxia / oxigenación",
            "normal": [96.0, 100.0],
            "preventivo_bajo": [92.0, 95.9],
            "critico_bajo": 92.0,
            "nasa_ref": "V1 Rev. B 3.1.5.f (oximetría), V2 6003 (P_I O2), Tabla 6.2-1"
        },
        "frec_respiratoria": {
