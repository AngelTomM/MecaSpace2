            "critico_bajo": 6.0,
            "nasa_ref": "V1 6001 (período recomendado 8.5 h/día), V2 8055 (ciclo 24h / 24h40m Marte)"
        },
        "estado_animo": {
            "unit": "pts (1-10)",
            "sensor": "Autorreporte multimodal",
            "indicador_consigna": "Estado de ánimo",
            "normal": [6.5, 10.0],
            "preventivo_bajo": [4.5, 6.49],
            "critico_bajo": 4.5,
            "nasa_ref": "Consigna, V1 3004.q (tratamiento conductual asíncrono), Tabla E.2-2 (*), V2 7071 (privacidad)"
