            "preventivo_alto": [95.1, 130.0],
            "critico_bajo": 45.0,
            "critico_alto": 130.0,
            "nasa_ref": "V1 3004.h, Tabla E.2-2, V2 11011 (>140 bpm deterioro en traje EVA; referencia clínica en cabina)"
