        }
    },
    "synergistic_critical_rules": [
        {
            "condition": "Hipoxia Compensada",
            "trigger": "spo2 < 95.0 AND frec_respiratoria > 20.0 AND frec_cardiaca > 110.0",
            "assigned_class": 2
        },
        {
            "condition": "Evento Coronario o Colapso Cardiovascular Agudo",
            "trigger": "frec_cardiaca > 125.0 AND anomalia_ecg > 0.30 AND spo2 < 94.0",
            "assigned_class": 2
        },
        {
            "condition": "Fatiga Circadiana Aguda",
            "trigger": "eficiencia_sueno < 72.0 AND anomalia_ecg > 0.20 AND frec_cardiaca > 100.0",
            "assigned_class": 2
        },
        {
            "condition": "Hipoglucemia por Privación de Sueño (V2 8055)",
            "trigger": "horas_sueno < 6.5 AND eficiencia_sueno < 75.0 AND glucemia < 68.0",
            "assigned_class": 2
        },
        {
            "condition": "Hiperglucemia / Desregulación Endocrina por Privación de Sueño (V2 8055)",
            "trigger": "horas_sueno < 6.5 AND eficiencia_sueno < 75.0 AND glucemia > 175.0",
            "assigned_class": 2
        },
        {
            "condition": "Estrés Térmico y Hemodinámico",
            "trigger": "temp_corporal > 37.3 AND presion_sistolica > 135.0 AND frec_cardiaca > 115.0",
            "assigned_class": 2
        }
    ]
}
