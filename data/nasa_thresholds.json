    },
    "cabin_environment": {
        "pi_o2_mmhg": {
            "unit": "mmHg",
            "normal": [145.0, 155.0],
            "preventivo_bajo": 127.0,
            "critico_bajo": 122.0,
            "nasa_ref": "V2 6003, Tabla 6.2-1 (leve 127 mmHg, mínimo absoluto 1 h 122 mmHg)"
        },
        "ppco2_mmhg": {
            "unit": "mmHg",
